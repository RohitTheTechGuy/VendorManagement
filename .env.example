# Server + client share this root .env (Vite envDir points here).

# --- Server ---
DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"
NODE_ENV=development
PORT=3001
# Must match the client origin exactly (credentials CORS).
CLIENT_ORIGIN=http://localhost:5173
# Base URL used to build vendor magic links.
APP_BASE_URL=http://localhost:5173
# Min 32 chars. Server fails to boot if unset.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Optional. When absent, invite emails are logged to the API console instead of sent.
RESEND_API_KEY=
RESEND_FROM=onboarding@vendor.local

# --- Client (Vite, must be VITE_-prefixed) ---
VITE_API_URL=http://localhost:3001
